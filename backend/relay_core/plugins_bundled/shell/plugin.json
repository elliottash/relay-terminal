{
  "schema_version": 2,
  "id": "relay.shell",
  "version": "0.1.0",
  "name": "Shell console",
  "description": "The default Bash console with Relay shell integration.",
  "activation": {},
  "router": {
    "language": "bash",
    "prose_fallback": "program"
  },
  "console": {
    "program": [
      "bash",
      "-i"
    ],
    "prompt_marks": "osc133",
    "startup": "relay-integration.bash"
  },
  "completion": {
    "kind": "shell"
  },
  "requires": [
    {
      "program": "bash"
    }
  ]
}
