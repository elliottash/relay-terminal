#!/usr/bin/env python3
"""relay-land: the landing queue's command line (card #FW1C, contract docs/TREES-AND-LANDING.md).

  relay-land submit SHA --request-id ID [--workspace-id W] [--card C] [--base-sha B]
                        [--kind code|metadata] [--test NAME ...]
  relay-land status [JOB]
  relay-land cancel JOB
  relay-land receipt JOB
  relay-land recover
  relay-land outbox [--all]

Service verbs (card #AMQQ, backend/relay_core/integration_service.py):

  relay-land run [--once]                  the publisher loop (gates, reconcile, publish, main)
  relay-land project-init [--write]        register the repo; suggest/write .relay/project.toml
  relay-land inventory | activate [--dry-run] | pause | rollback
  relay-land try SHA | --workspace ID      the accepted gate on a candidate, no publication
  relay-land main-status | main-run [-- ARGS...]
  relay-land snapshot | events | handoffs | board-submit PATH... --session S
  relay-land workspace create SESSION | status ID | release ID --owner O | remove ID | list

All verbs accept --repo and --state-root and print JSON. Exit 0 success, 1 usage, 2 refused,
3 conflict, 5 gate failure, 7 busy (publisher, admission or transition lock). Also runnable as
`python -m relay_core.integration_service` with the backend on sys.path.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "backend"))
from relay_core import landq  # noqa: E402

sys.exit(landq.main())
