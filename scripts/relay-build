#!/usr/bin/env python3
"""Build Relay: one build at a time, and never a stale object.

Several sessions share this checkout and this `build/` directory, and
`src/main.cpp` is one translation unit that takes minutes to compile. That is
enough for a build to succeed and still run old code:

    12:00:00  session X starts `cmake --build build`; the compiler reads
              src/Pane.h and every other header of the one translation unit
    12:00:35  session Y edits src/Pane.h
    12:03:00  X's main.cpp.o is written -- mtime 12:03:00, contents from 12:00:00
    12:03:10  Y runs `cmake --build build`: the object is newer than the header,
              so make rebuilds nothing, says "up to date", and ./build/relay
              still runs the code from before Y's edit.

This wrapper closes both holes. It takes an exclusive lock around the whole
configure-and-build, so two sessions cannot interleave; and when the build
finishes it sets every artifact it produced (objects, archives, shared objects,
ELF binaries) back to the time the build *started*. Any header edited while the
compile was running is then newer than the object built from it, so the next
build recompiles it -- which is what make would have done if compiling were
instantaneous.

Usage:

    scripts/relay-build                      # configure if needed, then build
    scripts/relay-build --target relay       # extra args go to `cmake --build`
    scripts/relay-build --fast --target relay # separate Ninja build with faster developer flags
    scripts/relay-build --check "Fold thinking"   # fail unless build/relay has it
    scripts/relay-build --wait-seconds 300   # give up if another build holds the lock

Environment: RELAY_JOBS sets the parallelism (default 8) but is only an upper
bound: the job count is clamped to what the memory limit this build runs under
allows (about one 2 GiB compile job per 2 GiB of limit), so a default build
inside an agent pane's 8 GiB systemd scope fits it instead of getting the pane
OOM-killed (card #04EC). RELAY_SESSION names this session in the "waiting for
..." message other sessions see.

Manual escape hatch if you ever suspect a stale object anyway:
`rm build/CMakeFiles/relay.dir/src/main.cpp.o` and build again.
"""

from __future__ import annotations

import argparse
import errno
import fcntl
import os
import stat
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

EXIT_OK = 0
EXIT_USAGE = 1
EXIT_LOCK_TIMEOUT = 2
EXIT_CONFIGURE = 3
EXIT_BUILD = 4
EXIT_CHECK = 5

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build"
LOCK = BUILD / ".relay-build.lock"

# Anything with one of these suffixes is a build product whose mtime make reads.
ARTIFACT_SUFFIXES = (".o", ".obj", ".lo", ".a", ".so", ".dylib", ".dll", ".lib", ".pdb")


def say(message: str) -> None:
    print(f"relay-build: {message}", flush=True)


def stamp(seconds: float) -> str:
    return datetime.fromtimestamp(seconds).strftime("%H:%M:%S")


# --------------------------------------------------------------------------- lock


def holder_of(fd: int) -> str:
    """Who is building, as the lock file's owner wrote it when it took the lock."""
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        text = os.read(fd, 4096).decode("utf-8", "replace").strip()
    except OSError:
        text = ""
    return text or "another session"


def acquire(wait_seconds: float) -> int | None:
    """Take the exclusive build lock, or return None if `wait_seconds` ran out.

    `wait_seconds` <= 0 waits for as long as it takes.
    """
    BUILD.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(LOCK), os.O_RDWR | os.O_CREAT, 0o644)
    deadline = None if wait_seconds <= 0 else time.monotonic() + wait_seconds
    announced = 0.0
    waited_from = None
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError as exc:
            if exc.errno not in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
                os.close(fd)
                raise
        now = time.monotonic()
        if waited_from is None:
            waited_from = now
        if now - announced > 30 or announced == 0.0:
            announced = now
            waiting = int(now - waited_from)
            more = f" ({waiting}s so far)" if waiting else ""
            say(f"waiting for {holder_of(fd)}'s build to finish{more}; "
                f"lock {LOCK}")
        if deadline is not None and now >= deadline:
            os.close(fd)
            return None
        time.sleep(0.25)
    me = f"pid {os.getpid()}"
    session = os.environ.get("RELAY_SESSION", "").strip()
    if session:
        me += f" (session {session})"
    me += f", building since {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    try:
        os.ftruncate(fd, 0)
        os.lseek(fd, 0, os.SEEK_SET)
        os.write(fd, me.encode())
        os.fsync(fd)
    except OSError:
        pass
    return fd


# ----------------------------------------------------------------------- restamp


def is_artifact(path: str, name: str, st: os.stat_result) -> bool:
    """True for a compiler or linker output, whose mtime the next build reads."""
    if name.endswith(ARTIFACT_SUFFIXES) or ".so." in name:
        return True
    if st.st_mode & 0o111 and st.st_size >= 4:
        try:
            with open(path, "rb") as handle:
                return handle.read(4) == b"\x7fELF"
        except OSError:
            return False
    return False


def restamp(build_dir: Path, start_ns: int) -> int:
    """Set every artifact this build produced back to the build's start time.

    All of them get the *same* time, so a binary is never older than the objects
    it was linked from: make and ninja both rebuild only on a strictly newer
    prerequisite, so equal timestamps are up to date.
    """
    count = 0
    for dirpath, _dirnames, filenames in os.walk(build_dir):
        for name in filenames:
            path = os.path.join(dirpath, name)
            try:
                st = os.lstat(path)
            except OSError:
                continue
            if not stat.S_ISREG(st.st_mode) or st.st_mtime_ns < start_ns:
                continue
            if not is_artifact(path, name, st):
                continue
            try:
                os.utime(path, ns=(start_ns, start_ns))
                count += 1
            except OSError:
                continue
    return count


# ------------------------------------------------------------------------- check


def binary_contains(path: Path, needle: str) -> bool:
    """Is this literal in the binary? (`grep -aF`, without spawning grep.)

    Looked for both as UTF-8 and as UTF-16LE: a `QStringLiteral("…")` -- most of Relay's
    interface text -- is stored as UTF-16 in the binary, so a UTF-8 byte search alone reports a
    change as missing when it is there (`strings -el build/relay` is the by-hand equivalent).
    """
    needles = [data for data in {needle.encode(), needle.encode("utf-16-le")} if data]
    if not needles:
        return True
    overlap = max(len(data) for data in needles) - 1
    tail = b""
    with open(path, "rb") as handle:
        while True:
            chunk = handle.read(1 << 20)
            if not chunk:
                return False
            window = tail + chunk
            if any(data in window for data in needles):
                return True
            tail = window[-overlap:] if overlap else b""


# -------------------------------------------------------------------- memory cap


# One compile job of the big translation units (src/main.cpp's) peaks at
# 1.4-1.9 GiB in the RelWithDebInfo build. Budget 2 GiB per job: four jobs then
# peak near 6 GiB and fit an agent pane's 8 GiB MemoryMax with room for the
# agent itself; the old default of 8 does not, and systemd killed the pane
# mid-build for exactly that on 2026-09-23 (card #04EC).
BYTES_PER_JOB = 2 * 1024 ** 3
DEFAULT_JOBS = 8


def memory_limit_bytes(cgroup_root="/sys/fs/cgroup", self_cgroup="/proc/self/cgroup",
                       meminfo="/proc/meminfo") -> "int | None":
    """Bytes of memory this build is allowed, or None when nothing sets a limit.

    Relay starts each agent pane in a systemd scope with MemoryMax
    (src/Isolation.h), so a build inside a pane sees that cap here. A plain
    terminal sees whatever its own cgroup says, if anything, else the host's RAM.
    """
    def read_limit(path) -> "int | None":
        try:
            text = Path(path).read_text().strip()
        except OSError:
            return None
        # cgroup v2 writes "max" when there is no limit; v1 writes a huge sentinel.
        return int(text) if text.isdigit() and int(text) > 0 else None

    limit = None

    # cgroup v2: the limit sits on this process's own cgroup (the pane scope) or
    # on an ancestor (user.slice); the nearest one that sets it wins.
    root = Path(cgroup_root)
    try:
        lines = Path(self_cgroup).read_text().splitlines()
        rel = next((l.split(":", 2)[2].lstrip("/") for l in lines if l.startswith("0::")), "")
    except (OSError, IndexError):
        rel = ""
    node = root / rel
    while True:
        value = read_limit(node / "memory.max")
        if value:
            limit = value
            break
        if node == root or node.parent == node:
            break
        node = node.parent

    if limit is None:
        # cgroup v1: one global memory controller, and "unlimited" is a sentinel.
        value = read_limit(root / "memory" / "memory.limit_in_bytes")
        if value and value < 1 << 44:
            limit = value

    # A cap above the machine's RAM is not a number to plan a build around.
    try:
        for line in Path(meminfo).read_text().splitlines():
            if line.startswith("MemTotal:"):
                total = int(line.split()[1]) * 1024
                limit = total if limit is None else min(limit, total)
                break
    except (OSError, ValueError, IndexError):
        pass
    return limit


def jobs_for_environment(environ, note=None, limit=None) -> str:
    """The `--parallel` job count: RELAY_JOBS (default 8), clamped to memory.

    A build inside an agent pane runs in a systemd scope with MemoryMax; eight
    parallel compiles of this repo peak past 8 GiB there and systemd stops the
    pane, which from the outside looks like the agent "ran out of memory" while
    doing nothing (card #04EC). An explicit RELAY_JOBS above the cap is lowered
    with a note rather than obeyed into an OOM; below the cap it wins untouched.
    """
    try:
        requested = int(str(environ.get("RELAY_JOBS") or DEFAULT_JOBS).strip())
    except ValueError:
        requested = DEFAULT_JOBS
    requested = max(1, requested)

    if limit is None:
        limit = memory_limit_bytes()
    if not limit:
        return str(requested)
    allowed = max(1, limit // BYTES_PER_JOB)
    if requested <= allowed:
        return str(requested)
    if note:
        note(f"RELAY_JOBS={requested} lowered to {allowed}: this build may use "
             f"{limit / 2 ** 30:.1f} GiB and one compile job peaks near "
             f"{BYTES_PER_JOB / 2 ** 30:.0f} GiB")
    return str(allowed)


# -------------------------------------------------------------------------- main


def configured() -> bool:
    if not (BUILD / "CMakeCache.txt").is_file():
        return False
    return (BUILD / "Makefile").is_file() or (BUILD / "build.ninja").is_file()


def parse_args(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    parser = argparse.ArgumentParser(
        prog="relay-build",
        description="Build Relay under a lock, with no stale objects left behind.",
        epilog="Unrecognized arguments are passed through to `cmake --build`, "
               "for example: relay-build --target relay-editor-tests",
    )
    parser.add_argument("--wait-seconds", type=float, default=0,
                        help="give up after N seconds waiting for another "
                             "session's build (default: wait forever)")
    parser.add_argument("--fast", action="store_true",
                        help="build in build-fast/ with Ninja, -O0 and minimal debug info")
    parser.add_argument("--check", metavar="STRING", action="append", default=[],
                        help="after building, fail unless this literal is in "
                             "build/relay (repeatable)")
    parser.add_argument("--check-binary", metavar="PATH", default=None,
                        help="the binary --check looks in (default build/relay)")
    parser.add_argument("--cmake-arg", metavar="ARG", action="append", default=[],
                        help="extra argument for the configure step; passing one "
                             "forces a reconfigure (repeatable)")
    parser.add_argument("--reconfigure", action="store_true",
                        help="run cmake even when build/ is already configured")
    parser.add_argument("--no-restamp", action="store_true",
                        help="leave the artifacts' mtimes alone (debugging only)")
    known, extra = parser.parse_known_args(argv)
    if extra and extra[0] == "--":
        extra = extra[1:]
    return known, extra


def main(argv: list[str]) -> int:
    global BUILD, LOCK
    args, extra = parse_args(argv)
    if args.fast:
        BUILD = ROOT / "build-fast"
        LOCK = BUILD / ".relay-build.lock"

    lock_fd = acquire(args.wait_seconds)
    if lock_fd is None:
        say(f"gave up after {args.wait_seconds:g}s waiting for the build lock; "
            f"nothing was built")
        return EXIT_LOCK_TIMEOUT
    try:
        # Everything this build writes is stamped back to here.
        start = time.time()
        start_ns = time.time_ns()

        if args.reconfigure or args.cmake_arg or not configured():
            command = ["cmake", "-S", str(ROOT), "-B", str(BUILD)]
            if args.fast:
                command += ["-G", "Ninja", "-DCMAKE_CXX_FLAGS_RELWITHDEBINFO=-O0 -g1 -DNDEBUG"]
            command += ["-DCMAKE_BUILD_TYPE=RelWithDebInfo", *args.cmake_arg]
            say("configuring: " + " ".join(command))
            code = subprocess.call(command, cwd=str(ROOT))
            if code != 0:
                # A reused build/ hides a broken configure: stop here rather
                # than build whatever the last good configure left behind.
                say(f"cmake configure failed ({code})")
                return EXIT_CONFIGURE

        jobs = jobs_for_environment(os.environ, note=say)
        command = ["cmake", "--build", str(BUILD), "--parallel", jobs, *extra]
        say("building: " + " ".join(command))
        code = subprocess.call(command, cwd=str(ROOT))
        if code != 0:
            say(f"build failed ({code})")
            return EXIT_BUILD

        if not args.no_restamp:
            count = restamp(BUILD, start_ns)
            say(f"built in {time.time() - start:.0f}s; {count} artifact(s) "
                f"stamped back to {stamp(start)}, the build's start, so a header "
                f"edited during it still gets recompiled")
        else:
            say(f"built in {time.time() - start:.0f}s; mtimes left alone")

        if args.check:
            binary = Path(args.check_binary) if args.check_binary else BUILD / "relay"
            if not binary.is_file():
                say(f"--check: {binary} does not exist")
                return EXIT_CHECK
            for needle in args.check:
                if not binary_contains(binary, needle):
                    say(f"--check failed: {binary.name} does not contain "
                        f"{needle!r} -- the build did not pick up your change")
                    return EXIT_CHECK
                say(f"--check: {binary.name} contains {needle!r}")
        return EXIT_OK
    finally:
        try:
            os.ftruncate(lock_fd, 0)
        except OSError:
            pass
        os.close(lock_fd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
