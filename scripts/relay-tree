#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""relay-tree — CLI adapter for relay_core.trees (card #RT3B).

Agent discovery and workspace lifecycle: register / resolve / configure /
create / list / get / release / sync / remove. Every command prints the JSON
record(s) on stdout and the refusal reason on stderr. Exit codes:
0 success, 1 usage/config, 2 refused, 3 conflict.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "backend"))

from relay_core import trees  # noqa: E402


class Parser(argparse.ArgumentParser):
    def error(self, message):  # usage errors are exit 1, not argparse's 2
        self.exit(1, f"{self.prog}: error: {message}\n")


def _common(p):
    p.add_argument("--repo", default=os.getcwd(),
                   help="registered repo path or repo id (default: cwd)")
    p.add_argument("--state-root", default=None,
                   help="override $XDG_STATE_HOME/relay (tests)")


def main(argv=None) -> int:
    parser = Parser(prog="relay-tree", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("register", help="register a repository's canonical identity")
    p.add_argument("path", nargs="?", default=os.getcwd())
    p.add_argument("--target", default=None)
    p.add_argument("--mode", default=None, choices=trees.REPO_MODES)
    p.add_argument("--repair", action="store_true",
                   help="explicitly repair a relocated Git common dir")
    p.add_argument("--state-root", default=None)

    p = sub.add_parser("configure", help="update mode/target metadata (B1 activates)")
    p.add_argument("--mode", default=None, choices=trees.REPO_MODES)
    p.add_argument("--target", default=None)
    _common(p)

    p = sub.add_parser("resolve", help="print the registered repo for a path (no allocation)")
    p.add_argument("path", nargs="?", default=os.getcwd())
    p.add_argument("--state-root", default=None)

    p = sub.add_parser("create", help="create (or idempotently return) a session workspace")
    p.add_argument("session", help="owning session (contract positional)")
    p.add_argument("--session", dest="session_opt", default=None,
                   help="alias for the positional SESSION")
    p.add_argument("--card", default=None)
    p.add_argument("--base", default=None, help="base ref (default: repo target)")
    p.add_argument("--exclude", action="append", default=[],
                   help="non-cone sparse exclusion (repeatable)")
    p.add_argument("--include", action="append", default=[],
                   help="explicit re-inclusion, e.g. own evidence (repeatable)")
    p.add_argument("--init", default=None,
                   help="init argv run inside the new tree (shlex-split, no shell)")
    p.add_argument("--retry", action="store_true", help="retry a failed init")
    p.add_argument("--max-workspaces", type=int, default=50)
    _common(p)

    p = sub.add_parser("list", help="list the repository's workspaces")
    p.add_argument("--all", action="store_true", help="include removed workspaces")
    _common(p)

    p = sub.add_parser("get", help="print one workspace record")
    p.add_argument("id")
    _common(p)

    p = sub.add_parser("release", help="release a workspace lease")
    p.add_argument("id")
    p.add_argument("--owner", required=True)
    _common(p)

    p = sub.add_parser("sync", help="explicitly rebase a workspace onto the target tip")
    p.add_argument("id")
    p.add_argument("--owner", required=True)
    _common(p)

    p = sub.add_parser("remove", help="remove a released, landed, clean workspace")
    p.add_argument("id")
    p.add_argument("--receipt", default=None,
                   help="queue receipt: JSON string, @file, or file path")
    _common(p)

    args = parser.parse_args(argv)
    try:
        if args.command == "register":
            out = trees.register_repo(args.path, state_root=args.state_root,
                                      target=args.target, mode=args.mode,
                                      repair=args.repair)
        elif args.command == "configure":
            out = trees.configure_repo(args.repo, state_root=args.state_root,
                                       mode=args.mode, target=args.target)
        elif args.command == "resolve":
            out = trees.resolve_project(args.path, state_root=args.state_root)
            if out is None:
                print(f"resolve: {args.path}: not inside a registered repository",
                      file=sys.stderr)
                return 1
        elif args.command == "create":
            out = trees.TreeManager(args.repo, state_root=args.state_root).create(
                args.session_opt or args.session, card=args.card, base=args.base,
                excludes=args.exclude, includes=args.include, init=args.init,
                retry=args.retry, max_workspaces=args.max_workspaces)
        elif args.command == "list":
            out = trees.TreeManager(args.repo, state_root=args.state_root).list(
                include_removed=args.all)
        elif args.command == "get":
            out = trees.TreeManager(args.repo, state_root=args.state_root).get(args.id)
        elif args.command == "release":
            out = trees.TreeManager(args.repo, state_root=args.state_root).release(
                args.id, owner=args.owner)
        elif args.command == "sync":
            out = trees.TreeManager(args.repo, state_root=args.state_root).sync(
                args.id, owner=args.owner)
        elif args.command == "remove":
            receipt = trees.parse_receipt(args.receipt) if args.receipt else None
            out = trees.TreeManager(args.repo, state_root=args.state_root).remove(
                args.id, receipt=receipt)
        else:  # pragma: no cover - argparse enforces the subcommand
            parser.error(f"unknown command {args.command}")
    except trees.TreeError as exc:
        print(f"relay-tree {args.command}: {exc}", file=sys.stderr)
        return exc.exit_code
    print(json.dumps(out, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
