[agent]
max_steps=17

[hints]
enabled=true

[hosted]
disclosed=true

[instructions]
onboarded=true

[logging]
level=info

[notifications]
desktop=true

[provider]
base=https://api.relay-terminal.ai/v1
extra={\"reasoning_effort\":\"medium\"}
model=relay-main
preset=relay-free

[terminal]
copy_on_select=true

[theme]
name=relay-light

[url_handler]
announced=true

[voice]
hold_key=right-alt
