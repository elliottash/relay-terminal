[agent]
max_steps=17
show_thinking=false
show_tool_output=true

[hints]
enabled=false

[hosted]
disclosed=true

[instructions]
onboarded=true

[logging]
level=debug

[notifications]
desktop=false

[provider]
base=https://api.relay-terminal.ai/v1
extra={\"reasoning_effort\":\"medium\"}
model=relay-main
preset=relay-free

[terminal]
copy_on_select=true

[theme]
name=relay-light

[url_handler]
announced=true

[voice]
hold_key=right-alt

[windows]
restore=false
